{
  // The web application's credential file. Copy this file to secrets.json in the application root,
  // fill in the one value, then run Set-CredentialFileAcl.ps1 against it under the application pool
  // identity.
  //
  // Leave Encrypted as false. The first request that starts the application validates the value,
  // encrypts it in place, and sets the flag to true. Do not set it by hand.
  //
  // This file is deliberately not named appsettings.something.json and is never registered as a
  // configuration source, so nothing watches it: an application that rewrites its own configuration
  // file while reloadOnChange is on recycles itself mid-startup.
  "Encrypted": false,

  // The password for this application's own SQL login, RCRAInfoMonitor. From the password manager.
  //
  // There is no ApiId or ApiKey here, and that is not an omission. The monitoring application never
  // calls EPA -- it reads what the loader recorded -- so it has no legitimate use for the API
  // credential, and the loader's copy of this file denies read access to this application's identity.
  "SqlPassword": ""
}
