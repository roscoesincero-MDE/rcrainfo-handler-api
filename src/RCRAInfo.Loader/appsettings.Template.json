{
  // The console application's NON-SECRET configuration. Copy this file to appsettings.json beside the
  // executable and fill in the two values. Nothing here is a secret: the SQL password and the RCRAInfo
  // API pair live in secrets.json, which this application encrypts in place on its first run.
  //
  // Everything below can also be supplied as an environment variable, which is how a Task Scheduler
  // action configures a machine with no configuration file. The separator is a DOUBLE UNDERSCORE:
  //   RCRAInfoData__ConnectionString, RCRAInfoApi__BaseAddress
  // Environment variables win over this file.

  "RCRAInfoData": {
    // The loader's own SQL login and NO password -- the password is the one thing this file must never
    // hold. Integrated Security is refused as well: it would make the validated password irrelevant and
    // every password would then appear to be correct.
    "ConnectionString": "Server=(local);Database=RCRAInfo;User ID=RCRAInfoLoader;Encrypt=True;TrustServerCertificate=True",

    // The most elements this loader will put in one JSON payload parameter. Optional; the default is 500.
    //
    // IT IS A CEILING ON THE LOOKUP REFRESH, AND THAT IS WHAT DECIDES THE VALUE. A /lookup/hd list is
    // refreshed in Full mode, which retires every code the payload does not carry, so a list too large for
    // one call CANNOT be split -- the second call would retire everything the first wrote. The refresh
    // refuses such a list outright and reports TooLarge, leaving the previous mirror intact and one run
    // stale. Naics is the list that decides this number: EPA serves 1,701 codes for it, so at the 500
    // default that one list never loads at all.
    //
    // 2,500 gives Naics room to grow without another config change. The other 22 lists are two orders of
    // magnitude smaller. Raising it does NOT widen the handler fetch batches -- RCRAInfoLoad:FetchBatchSize
    // governs those and the loop takes the smaller of the two -- so the only other thing this number
    // touches is how many version rows the CurrentRecord reconciliation asserts per call.
    "MaxPayloadElements": 2500
  },

  "RCRAInfoApi": {
    // EPA's RCRAInfo REST root FOR THIS ENVIRONMENT, including the /rcra-api/rest path:
    //   preprod     https://rcranodepreprod.epa.gov/rcra-api/rest
    //   production  https://rcranode.epa.gov/rcra-api/rest
    //
    // There is deliberately no default. The API ID and Key are issued per environment, so a default
    // would let a run authenticate against the wrong one and report success -- and the worst version of
    // that mistake writes preprod data into the Production database overnight with nobody watching.
    // A missing value is a start-up failure with exit code 4.
    "BaseAddress": "",

    // Optional; the defaults are these. Times are TimeSpans (hh:mm:ss).
    //
    // TokenRefreshMargin  -- how far ahead of a token's expiry to renew it. EPA's tokens live 20
    //                        minutes and an initial load outlives many of them. Capped internally at
    //                        half the token's own lifetime, so a shorter-lived token than expected
    //                        cannot cause a renewal per request.
    // MinimumRefreshInterval -- the floor on the auth-call rate. Protects against a token that arrives
    //                        already expired, which is what a clock disagreement with EPA looks like
    //                        from here; without a floor that becomes one auth call per request.
    "RequestTimeout": "00:00:30",
    "TokenRefreshMargin": "00:02:00",
    "MinimumRefreshInterval": "00:00:05",

    // How hard this loader pushes EPA, and what it does when EPA pushes back. All optional; the defaults
    // are these. As environment variables: RCRAInfoApi__Throttle__MaxRequestsPerSecond, and so on.
    //
    // EPA PUBLISHES NO RATE LIMIT (open question G21). Two requests per second is therefore an
    // assumption, chosen deliberately low: it is about 172,000 requests a day, and the initial load needs
    // roughly two requests per handler version because other-ids is fetched per handler. So a first full
    // load takes days rather than hours. That is the right trade against a service whose tolerance nobody
    // has measured -- being throttled is recoverable, being blocked is a phone call. Raise it once
    // workstream F2 has watched a real load and counted the 429s.
    //
    // MaxRequestsPerSecond -- how often a request may START. A rate, not a burst: idle time earns no
    //                        credit, because a saved-up burst after a pause is the traffic shape most
    //                        likely to be read as abuse. There is no "0 means unlimited" value.
    //                        Fractional values are exact, so 0.5 is a legal answer to a 429 problem.
    // MaxConcurrentRequests -- how many may be in flight at once, including their response bodies. This
    //                        is also the ceiling on the fetch loop's parallelism, and it is enforced for
    //                        every caller rather than only that loop.
    // MaxRetryAttempts     -- retries after the first try, for 429, 5xx, a timeout or a dropped
    //                        connection. 0 is legal and means one attempt.
    // RetryDelay/MaxRetryDelay -- exponential backoff with jitter, from RetryDelay, capped at
    //                        MaxRetryDelay: 2s, 4s, 8s, each randomised. A Retry-After header from EPA
    //                        wins over all of this, which is the whole of "back off politely".
    // AttemptTimeout       -- one attempt, including its wait for a rate slot and its body download.
    // TotalRequestTimeout  -- all attempts together. MUST exceed AttemptTimeout, and by enough for the
    //                        ladder above: set it too low and it silently becomes the real retry limit.
    //
    // A note for whoever reads logs.HandlerLoadAttempt afterwards: retries here are invisible to that
    // table. One fetch is one attempt row, so a version that succeeded on its third try records the
    // third try only. The earlier two are in the resilience pipeline's own telemetry.
    "Throttle": {
      "MaxRequestsPerSecond": 2,
      "MaxConcurrentRequests": 2,
      "MaxRetryAttempts": 3,
      "RetryDelay": "00:00:02",
      "MaxRetryDelay": "00:00:30",
      "AttemptTimeout": "00:00:30",
      "TotalRequestTimeout": "00:02:00"
    }
  },

  "RCRAInfoLoad": {
    // The two-letter activityLocation this installation loads. REQUIRED, and there is deliberately no
    // default: G2 settles it as MD for MDE, but a default would let a mis-deployed installation quietly
    // mirror a different state's Handler data -- and the lookup refresh runs in Full mode, which RETIRES
    // every code it does not see within the activity locations the payload mentions. Repointing an
    // established mirror at a second state ADDS that state beside Maryland's rather than replacing it.
    "ActivityLocation": "MD",

    // The first day the INITIAL LOAD asks for. REQUIRED BEFORE THE FIRST RUN, and there is deliberately no
    // default, for ActivityLocation's reason: it decides how far back this mirror reaches, and getting it
    // wrong is invisible afterwards. The walk reports every window it asked for as walked; it simply never
    // asked for the years before this date, and /hd/sources/summaries has no envelope that would reveal it.
    //
    // WHY IT IS NEEDED AT ALL. config.LoadWatermark starts with WatermarkDate NULL, and
    // config.uspGetLoadWatermark reads that as "ask for everything" -- it recommends a Full run with no
    // from-date. But /hd/sources/summaries REQUIRES startDate, so "everything" has to be given a first day
    // from somewhere, and this is it. Without it the first run is refused with exit code 8 and a message
    // naming this setting.
    //
    // 1980-01-01 IS THE RECOMMENDED VALUE -- roughly when the RCRA notification programme began, so it is
    // early enough to reach the oldest genuine handler record. Anything before 1900-01-01 is refused: that
    // is the shape a dropped digit in the year has, and 0001-01-01 is about 105,000 windows at the default
    // width, which presents as a load that never finishes rather than as an error. Open question G38 notes
    // the one residual risk: a legacy row stamped with a placeholder date such as 1900-01-01 would sit
    // before this floor and never be asked for. Workstream F2 can settle it with one wide window.
    //
    // IT IS A FLOOR, NOT A START. Whenever config.uspGetLoadWatermark recommends a from-date, that
    // recommendation wins -- so this value cannot rewind an established mirror and cannot be used to
    // re-load history. Re-loading history is config.uspSetLoadWatermark's job, which records who rewound
    // the bookmark and when. Leaving this set after the initial load is therefore harmless.
    "InitialLoadFromDate": "1980-01-01",

    // How many days one /hd/sources/summaries call covers. Optional; the default is 7, maximum 366.
    //
    // This is the ONLY lever on how large a summaries response gets, because that endpoint has no paging
    // and no envelope -- it answers with a bare JSON array, so there is no way to tell "these are all the
    // versions in the range" from "this is as many as the service felt like sending". A narrow window is
    // the only defence, which is why the default is deliberately on the small side.
    //
    // It is also the retry granularity, and the unit the watermark advances in. The bookmark moves to the
    // end of the last window in an UNBROKEN RUN of walked windows from the start of the range -- so a window
    // that fails costs its own dates and everything after them, not the whole run. That is what lets a long
    // catch-up converge: nothing guarantees the scheduled task ran, and a missed month or a first load
    // covering the whole notification era arrives here as one wide range. Forty-six years at 7 days is
    // roughly 2,400 windows, and requiring all 2,400 before ANY progress is durable would mean one transient
    // 500 in hour six costs the whole night, every night. Wider windows mean fewer calls and a coarser thing
    // to lose.
    "WindowDays": 7,

    // Resume. A killed run leaves its progress in logs.HandlerLoadStatus and the next run reads it back
    // rather than starting over -- /hd/sources/summaries has no offset and no limit, so there is no page
    // to restart at and that table is the only record of how far a run got. Both optional; defaults here.
    //
    // AbandonAfterMinutes -- how long a run may sit at 'Running' before the next run treats it as killed.
    //                     THIS ONE SETTING IS SENT TO TWO PROCEDURES AND THEY MUST AGREE, which is why it
    //                     is a setting and not two. logs.uspStartLoadRun uses it to sweep the dead run's
    //                     row to 'Abandoned'; logs.uspGetHandlerLoadResumeSet uses it to decide whether a
    //                     'Running' row is a corpse worth resuming from -- and the resume read
    //                     necessarily runs FIRST, because the start procedure takes the resumed-from run
    //                     as an input. So at the moment the resume read looks, a run killed by a reboot
    //                     has NOT been swept yet and still says 'Running'. Minimum 15 minutes, enforced
    //                     in both procedures: shorter, and a healthy in-flight run gets declared dead and
    //                     its versions handed to a second run as work somebody else already did.
    // ResumeMaxAgeHours -- how old a previous run's success may be and still be trusted enough to skip.
    //                     Null (or omitted entirely) means no limit. This is a correctness setting, not
    //                     housekeeping: EPA updates a handler source IN PLACE -- the natural key does not
    //                     move -- so skipping a version because a three-week-old run succeeded on it can
    //                     miss a real update and report a clean load. The trade is asymmetric, which is
    //                     why the default is conservative: re-fetching an unchanged version costs two
    //                     requests and merges as Unchanged, while wrongly skipping a changed one leaves a
    //                     stale row that nothing will ever ask about again. 48 hours covers a nightly
    //                     schedule with a night to spare. Set it to null only when re-driving a long
    //                     initial load by hand.
    "AbandonAfterMinutes": 720,
    "ResumeMaxAgeHours": 48,

    // How often the buffered logs.HandlerLoadStatus and logs.HandlerLoadAttempt rows are written --
    // whichever of the two comes first. Both are optional; the defaults are these.
    //
    // FlushRowCount  -- rows buffered, counted across both tables, before a flush. Bounds how much a
    //                   crash can lose and how large one JSON payload gets. A flush triggered by this
    //                   blocks the fetch that triggered it, on purpose: if the database cannot keep up,
    //                   the right answer is fewer fetches, not an unbounded buffer.
    // FlushInterval  -- how long rows may sit before the next buffered row forces a flush. This is what
    //                   bounds how stale the monitoring web application's view of a running load is.
    //
    // Both are starting points and neither has been measured against EPA yet -- that is workstream F2,
    // which needs an API credential. Tune them there rather than guessing here.
    "FlushRowCount": 100,
    "FlushInterval": "00:00:30"
  }
}
