{
  // The console application's credential file. Copy this file to secrets.json beside the executable,
  // fill in the three values, then run Set-CredentialFileAcl.ps1 against it -- the ACL is the control,
  // not the encryption (DPAPI LocalMachine ciphertext is readable by any process on this machine).
  //
  // Leave Encrypted as false. The first run validates the values, encrypts them in place, and sets the
  // flag to true. Do not set it by hand: a flag claiming encryption over a value that was never
  // encrypted is refused, and correctly.
  //
  // If validation fails, the file is left exactly as you typed it so the typo can be corrected here.
  // Once the flag reads true the plaintext is gone from this machine -- the password manager entry is
  // the only copy. Comments and formatting do not survive that first run.
  "Encrypted": false,

  // The password for this application's own SQL login, RCRAInfoLoader. From the password manager.
  "SqlPassword": "",

  // The RCRAInfo API ID and API Key, generated together in RCRAInfo. They are one credential: supply
  // both or neither. The Key is displayed once, so paste it straight in here.
  "ApiId": "",
  "ApiKey": ""
}
