-- =================================================================================================
-- CASE 3: the alternative that was considered and is expected to lose. Split the ID-prefix case out
-- into its own seekable query. If the seek is dramatically cheaper than CASE 2b, the extra 60 lines
-- of duplicated predicate might be worth it; if it is not, one OR'd scan is the answer.
-- =================================================================================================
DECLARE @Term NVARCHAR (200) = N'MD00000123';
DECLARE @Prefix NVARCHAR (402) = @Term + N'%';
PRINT N'--- CASE 3: IX_H_Grid, ID-prefix ONLY, seekable (no OR) ---';
SET STATISTICS IO ON;
SELECT COUNT (*) AS SeekableIdPrefixRows
  FROM #H AS v
 WHERE v.IsDeleted = 0 AND v.CurrentRecord = 1
   AND v.HandlerId LIKE @Prefix ESCAPE N'\'
OPTION (RECOMPILE);
SET STATISTICS IO OFF;
GO
-- =================================================================================================
-- CASE 4: what a one-character term would have cost, which is why 506 refuses one. Not an
-- optimisation question -- the cost is the same scan -- but the RESULT is 100,000 rows ranked by a
-- CASE that cannot separate them, of which the caller sees an arbitrary 25.
-- =================================================================================================
DECLARE @Term NVARCHAR (200) = N'A';
DECLARE @Contains NVARCHAR (402) = N'%' + @Term + N'%';
PRINT N'--- CASE 4: IX_H_Grid, one-character term (REFUSED by 506; measured to justify the refusal) ---';
SET STATISTICS IO ON;
SELECT COUNT (*) AS OneCharacterTermRows
  FROM #H AS v
 WHERE v.IsDeleted = 0 AND v.CurrentRecord = 1
   AND (v.HandlerId LIKE @Contains ESCAPE N'\' OR v.HandlerName LIKE @Contains ESCAPE N'\'
     OR v.SiteLocationCity LIKE @Contains ESCAPE N'\')
OPTION (RECOMPILE);
SET STATISTICS IO OFF;
GO
-- =================================================================================================
-- CASE 5: THE AS-BUILT PREDICATE. CASE 3 showed an ID-prefix SEEK costs 6 logical reads against the
-- 1,826 of CASE 2b's OR'd scan -- 300 times less for the search a monitoring user does most, which is
-- to paste a handler ID. The question CASE 5 answers is whether both can live in ONE query.
--
-- @IdShaped is a BIT decided in T-SQL before the query runs. Under OPTION (RECOMPILE) it is embedded
-- as a constant at compile time, so one of the two OR groups below is constant-false and eliminated:
-- either the predicate that reaches the optimizer is a bare seekable prefix, or it is a bare
-- contains-scan. Same mechanism 503 measured on its CASE-based ORDER BY. If it works, 506 keeps one
-- WHERE clause instead of two code paths.
-- =================================================================================================
DECLARE @Term NVARCHAR (200) = N'MD00000123', @IdShaped BIT = 1
      , @Skip INT = 0, @Take INT = 25, @TotalRows INT = 0;
DECLARE @Exact NVARCHAR (200) = @Term
      , @Prefix NVARCHAR (402) = @Term + N'%'
      , @Contains NVARCHAR (402) = N'%' + @Term + N'%';
DECLARE @Hits TABLE (Ordinal INT NOT NULL PRIMARY KEY, HandlerSourceId INT NOT NULL, MatchRank TINYINT NOT NULL);
PRINT N'--- CASE 5a: as-built, @IdShaped = 1, term MD00000123 ---';
SET STATISTICS IO ON;
SELECT @TotalRows = COUNT (*)
  FROM #H AS v
 WHERE v.IsDeleted = 0 AND v.CurrentRecord = 1
   AND ((@IdShaped = 1 AND v.HandlerId LIKE @Prefix ESCAPE N'\')
     OR (@IdShaped = 0 AND (v.HandlerId LIKE @Contains ESCAPE N'\'
                         OR v.HandlerName LIKE @Contains ESCAPE N'\'
                         OR v.SiteLocationCity LIKE @Contains ESCAPE N'\')))
OPTION (RECOMPILE);
INSERT INTO @Hits (Ordinal, HandlerSourceId, MatchRank)
SELECT p.Ordinal, p.HandlerSourceId, p.MatchRank
  FROM (SELECT ROW_NUMBER () OVER (ORDER BY m.MatchRank ASC, m.HandlerName ASC, m.HandlerSourceId ASC) AS Ordinal
             , m.HandlerSourceId, m.MatchRank
          FROM (SELECT v.HandlerSourceId, v.HandlerName
                     , CASE WHEN v.HandlerId        =    @Exact                THEN CAST (1 AS TINYINT)
                            WHEN v.HandlerId        LIKE @Prefix   ESCAPE N'\' THEN CAST (2 AS TINYINT)
                            WHEN v.HandlerId        LIKE @Contains ESCAPE N'\' THEN CAST (3 AS TINYINT)
                            WHEN v.HandlerName      LIKE @Prefix   ESCAPE N'\' THEN CAST (4 AS TINYINT)
                            WHEN v.HandlerName      LIKE @Contains ESCAPE N'\' THEN CAST (5 AS TINYINT)
                            WHEN v.SiteLocationCity LIKE @Prefix   ESCAPE N'\' THEN CAST (6 AS TINYINT)
                            ELSE CAST (7 AS TINYINT) END AS MatchRank
                  FROM #H AS v
                 WHERE v.IsDeleted = 0 AND v.CurrentRecord = 1
                   AND ((@IdShaped = 1 AND v.HandlerId LIKE @Prefix ESCAPE N'\')
                     OR (@IdShaped = 0 AND (v.HandlerId LIKE @Contains ESCAPE N'\'
                                         OR v.HandlerName LIKE @Contains ESCAPE N'\'
                                         OR v.SiteLocationCity LIKE @Contains ESCAPE N'\')))) AS m) AS p
 WHERE p.Ordinal > @Skip AND p.Ordinal <= @Skip + @Take
OPTION (RECOMPILE);
SET STATISTICS IO OFF;
DECLARE @RowsOnPage INT = (SELECT COUNT (*) FROM @Hits);
PRINT CONCAT (N'    TotalRows=', @TotalRows, N'  RowsOnPage=', @RowsOnPage);
GO
DECLARE @Term NVARCHAR (200) = N'ACME', @IdShaped BIT = 0
      , @Skip INT = 0, @Take INT = 25, @TotalRows INT = 0;
DECLARE @Exact NVARCHAR (200) = @Term
      , @Prefix NVARCHAR (402) = @Term + N'%'
      , @Contains NVARCHAR (402) = N'%' + @Term + N'%';
DECLARE @Hits TABLE (Ordinal INT NOT NULL PRIMARY KEY, HandlerSourceId INT NOT NULL, MatchRank TINYINT NOT NULL);
PRINT N'--- CASE 5b: as-built, @IdShaped = 0, term ACME ---';
SET STATISTICS IO ON;
SELECT @TotalRows = COUNT (*)
  FROM #H AS v
 WHERE v.IsDeleted = 0 AND v.CurrentRecord = 1
   AND ((@IdShaped = 1 AND v.HandlerId LIKE @Prefix ESCAPE N'\')
     OR (@IdShaped = 0 AND (v.HandlerId LIKE @Contains ESCAPE N'\'
                         OR v.HandlerName LIKE @Contains ESCAPE N'\'
                         OR v.SiteLocationCity LIKE @Contains ESCAPE N'\')))
OPTION (RECOMPILE);
INSERT INTO @Hits (Ordinal, HandlerSourceId, MatchRank)
SELECT p.Ordinal, p.HandlerSourceId, p.MatchRank
  FROM (SELECT ROW_NUMBER () OVER (ORDER BY m.MatchRank ASC, m.HandlerName ASC, m.HandlerSourceId ASC) AS Ordinal
             , m.HandlerSourceId, m.MatchRank
          FROM (SELECT v.HandlerSourceId, v.HandlerName
                     , CASE WHEN v.HandlerId        =    @Exact                THEN CAST (1 AS TINYINT)
                            WHEN v.HandlerId        LIKE @Prefix   ESCAPE N'\' THEN CAST (2 AS TINYINT)
                            WHEN v.HandlerId        LIKE @Contains ESCAPE N'\' THEN CAST (3 AS TINYINT)
                            WHEN v.HandlerName      LIKE @Prefix   ESCAPE N'\' THEN CAST (4 AS TINYINT)
                            WHEN v.HandlerName      LIKE @Contains ESCAPE N'\' THEN CAST (5 AS TINYINT)
                            WHEN v.SiteLocationCity LIKE @Prefix   ESCAPE N'\' THEN CAST (6 AS TINYINT)
                            ELSE CAST (7 AS TINYINT) END AS MatchRank
                  FROM #H AS v
                 WHERE v.IsDeleted = 0 AND v.CurrentRecord = 1
                   AND ((@IdShaped = 1 AND v.HandlerId LIKE @Prefix ESCAPE N'\')
                     OR (@IdShaped = 0 AND (v.HandlerId LIKE @Contains ESCAPE N'\'
                                         OR v.HandlerName LIKE @Contains ESCAPE N'\'
                                         OR v.SiteLocationCity LIKE @Contains ESCAPE N'\')))) AS m) AS p
 WHERE p.Ordinal > @Skip AND p.Ordinal <= @Skip + @Take
OPTION (RECOMPILE);
SET STATISTICS IO OFF;
DECLARE @RowsOnPage INT = (SELECT COUNT (*) FROM @Hits);
PRINT CONCAT (N'    TotalRows=', @TotalRows, N'  RowsOnPage=', @RowsOnPage);
GO
-- CASE 6: the same as-built predicate WITHOUT the recompile, to show what the fold is worth. If the
-- constant cannot be embedded, neither OR group can be eliminated and the seek is unreachable.
DECLARE @Term NVARCHAR (200) = N'MD00000123', @IdShaped BIT = 1;
DECLARE @Prefix NVARCHAR (402) = @Term + N'%', @Contains NVARCHAR (402) = N'%' + @Term + N'%';
PRINT N'--- CASE 6: as-built predicate, @IdShaped = 1, NO OPTION (RECOMPILE) ---';
SET STATISTICS IO ON;
SELECT COUNT (*) AS NoRecompileRows
  FROM #H AS v
 WHERE v.IsDeleted = 0 AND v.CurrentRecord = 1
   AND ((@IdShaped = 1 AND v.HandlerId LIKE @Prefix ESCAPE N'\')
     OR (@IdShaped = 0 AND (v.HandlerId LIKE @Contains ESCAPE N'\'
                         OR v.HandlerName LIKE @Contains ESCAPE N'\'
                         OR v.SiteLocationCity LIKE @Contains ESCAPE N'\')));
SET STATISTICS IO OFF;
GO
DROP TABLE IF EXISTS #H;
GO
PRINT N'measure506_search: done.';
GO
