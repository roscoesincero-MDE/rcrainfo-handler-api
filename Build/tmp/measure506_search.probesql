                     , CASE WHEN v.HandlerId        =    @Exact                THEN CAST (1 AS TINYINT)
                            WHEN v.HandlerId        LIKE @Prefix   ESCAPE N'\' THEN CAST (2 AS TINYINT)
                            WHEN v.HandlerId        LIKE @Contains ESCAPE N'\' THEN CAST (3 AS TINYINT)
                            WHEN v.HandlerName      LIKE @Prefix   ESCAPE N'\' THEN CAST (4 AS TINYINT)
                            WHEN v.HandlerName      LIKE @Contains ESCAPE N'\' THEN CAST (5 AS TINYINT)
                            WHEN v.SiteLocationCity LIKE @Prefix   ESCAPE N'\' THEN CAST (6 AS TINYINT)
