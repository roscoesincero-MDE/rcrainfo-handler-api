SET NOCOUNT ON;
SELECT N'Z-suffixed  -> ' + ISNULL (CONVERT (NVARCHAR (40), TRY_CAST (N'2026-09-05T12:34:56.7890000Z' AS DATETIME2), 121), N'NULL');
SELECT N'no suffix   -> ' + ISNULL (CONVERT (NVARCHAR (40), TRY_CAST (N'2026-09-05T12:34:56.7890000'  AS DATETIME2), 121), N'NULL');
SELECT N'offset +00  -> ' + ISNULL (CONVERT (NVARCHAR (40), TRY_CAST (N'2026-09-05T12:34:56.789+00:00' AS DATETIME2), 121), N'NULL');
SELECT N'date ISO    -> ' + ISNULL (CONVERT (NVARCHAR (40), TRY_CAST (N'2026-09-05' AS DATE), 23), N'NULL');
SELECT N'date w/time -> ' + ISNULL (CONVERT (NVARCHAR (40), TRY_CAST (N'2026-09-05T00:00:00.0000000' AS DATE), 23), N'NULL');
SELECT N'bit true    -> ' + ISNULL (CONVERT (NVARCHAR (10), TRY_CAST (N'true' AS BIT)), N'NULL');
SELECT N'bit 1       -> ' + ISNULL (CONVERT (NVARCHAR (10), TRY_CAST (N'1' AS BIT)), N'NULL');
SELECT N'openjson bit-> ' + ISNULL (CONVERT (NVARCHAR (10), (SELECT B FROM OPENJSON (N'[{"b":true}]') WITH (B BIT '$.b'))), N'NULL');
SELECT N'openjson dt2-> ' + ISNULL (CONVERT (NVARCHAR (40), (SELECT D FROM OPENJSON (N'[{"d":"2026-09-05T12:34:56.7890000Z"}]') WITH (D DATETIME2 '$.d')), 121), N'NULL');
