SET NOCOUNT ON;
DECLARE @Procs TABLE (Ordinal INT IDENTITY (1, 1), Name NVARCHAR (200));
INSERT INTO @Procs (Name) VALUES
  (N'dbo.uspReconcileCurrentRecord'), (N'dbo.uspRefreshLookupSet'),
  (N'dbo.uspSoftDeleteHandlerSourceSet'), (N'logs.uspStartLoadRun'),
  (N'logs.uspCompleteLoadRun'), (N'config.uspSetLoadWatermark');
DECLARE @i INT = 1, @n INT = (SELECT MAX (Ordinal) FROM @Procs), @Name NVARCHAR (200), @Sql NVARCHAR (MAX), @Cols INT;
WHILE @i <= @n
BEGIN
    SELECT @Name = Name FROM @Procs WHERE Ordinal = @i;
    SELECT @Sql = CONCAT (N'EXEC ', @Name, N' ',
        ISNULL (STUFF ((SELECT CONCAT (N', ', pa.name, N' = NULL')
                        FROM sys.parameters AS pa
                        WHERE pa.object_id = OBJECT_ID (@Name) AND pa.is_output = 0
                        ORDER BY pa.parameter_id
                        FOR XML PATH (N''), TYPE).value (N'.', N'NVARCHAR(MAX)'), 1, 2, N''), N''));
    SELECT @Cols = COUNT (*) FROM sys.dm_exec_describe_first_result_set (@Sql, NULL, 0);
    PRINT CONCAT (@Name, N' -> first result set columns: ', @Cols);
    SET @i += 1;
END;
