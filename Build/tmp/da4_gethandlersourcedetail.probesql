GO
-- tempdb.sys.columns rather than COLUMNPROPERTY: from this database's context COLUMNPROPERTY (OBJECT_ID
-- ('tempdb..#Detail'), ...) returns NULL, measured, so an assertion built on it would report nothing and pass.
DECLARE @ShapeCols INT = (SELECT COUNT (*) FROM tempdb.sys.columns
                           WHERE object_id = OBJECT_ID (N'tempdb..#Detail'));
IF @ShapeCols = 215 PRINT N'#Detail built with 215 column(s), copied from the view.';
ELSE                PRINT CONCAT (N'FAIL shape: #Detail has ', @ShapeCols, N' column(s), expected 215. Re-run '
                                , N'build/tmp/gen505_projection.py -- every INSERT ... EXEC below asserts this shape.');
GO

-- ---------------------------------------------------------------------------------------------------------------------
-- The log baseline. Every count in section L is taken above this id, so a second run of this file asserts the same
-- things rather than twice as many.
-- ---------------------------------------------------------------------------------------------------------------------
CREATE TABLE #Base (Label NVARCHAR (20) NOT NULL PRIMARY KEY, Value BIGINT NOT NULL);
INSERT INTO #Base (Label, Value)
SELECT N'MaxLogId', COALESCE (MAX (l.ExecutionLogId), 0) FROM logs.ExecutionLog AS l;
DECLARE @Mark BIGINT = (SELECT Value FROM #Base WHERE Label = N'MaxLogId');   -- see the note above #Ids on error 1046
PRINT CONCAT (N'baseline: logs.ExecutionLog high-water mark ', @Mark);
GO


PRINT N'';
PRINT N'--- A. Refusals, and the two ways of returning nothing -------------------------------------------------------';
GO

-- A0. NO ARGUMENTS. Error 201, raised by the SERVER before the body executes. Plain EXEC: there is nothing to insert.
BEGIN TRY
    EXEC dbo.uspGetHandlerSourceDetail;
    PRINT N'FAIL A0: a bare EXEC returned instead of failing -- @HandlerSourceId has acquired a default.';
END TRY
BEGIN CATCH
    IF ERROR_NUMBER () = 201 AND ERROR_MESSAGE () LIKE N'%@HandlerSourceId%'
        PRINT N'PASS A0: a bare EXEC fails with error 201 naming @HandlerSourceId, before the body runs.';
    ELSE
        PRINT CONCAT (N'FAIL A0: expected error 201 naming @HandlerSourceId, got ', ERROR_NUMBER (), N' -- '
                    , ERROR_MESSAGE ());
END CATCH;
GO

-- A0b. THE LIMIT, ASSERTED RATHER THAN GLOSSED. Error 201 happens before the TRY/CATCH exists, so A0 wrote no log row.
-- MDE's requirement is that any error is recorded, and this is the one case in this procedure where that is impossible
-- from inside it. Written to print CHANGED rather than PASS if it ever stops being true, because that would be good
-- news needing a header update rather than a failure.
DECLARE @Written INT;
SELECT @Written = COUNT (*)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > (SELECT Value FROM #Base WHERE Label = N'MaxLogId')
   AND l.ProcedureName = N'[dbo].[uspGetHandlerSourceDetail]';
IF @Written = 0
    PRINT N'PASS A0b: error 201 wrote NO log row, which is the documented limit of a required parameter.';
ELSE
    PRINT CONCAT (N'CHANGED A0b: error 201 now writes ', @Written, N' log row(s). Update 505''s header -- the '
                , N'"one error it cannot log" is no longer true.');
GO

-- A1. NULL. Not a race and not a missing record: a caller that sent nothing.
BEGIN TRY
    EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = NULL;
    PRINT N'FAIL A1: @HandlerSourceId = NULL returned instead of throwing.';
END TRY
BEGIN CATCH
    IF ERROR_MESSAGE () LIKE N'%is not a possible row identifier%'
       AND ERROR_MESSAGE () LIKE N'%EMPTY RESULT SET%'
        PRINT N'PASS A1: NULL is refused, and the message distinguishes the refusal from the empty-set race.';
    ELSE
        PRINT CONCAT (N'FAIL A1: wrong message -- ', ERROR_MESSAGE ());
END CATCH;
GO

-- A2. ZERO. The unbound control, and the reason the refusal covers more than NULL.
BEGIN TRY
    EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = 0;
    PRINT N'FAIL A2: @HandlerSourceId = 0 returned an empty set instead of throwing -- the empty set now means two '
        + N'different things.';
END TRY
BEGIN CATCH
    IF ERROR_MESSAGE () LIKE N'%is not a possible row identifier%'
       AND ERROR_MESSAGE () LIKE N'%IDENTITY starting at 1%'
        PRINT N'PASS A2: 0 is refused, and the message says why no such row could ever have existed.';
    ELSE
        PRINT CONCAT (N'FAIL A2: wrong message -- ', ERROR_MESSAGE ());
END CATCH;
GO

-- A3. NEGATIVE. Same class, and worth its own assertion because a <= 0 test and an = 0 test look identical until one
-- of them is wrong.
BEGIN TRY
    EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = -1;
    PRINT N'FAIL A3: @HandlerSourceId = -1 returned instead of throwing.';
END TRY
BEGIN CATCH
    IF ERROR_MESSAGE () LIKE N'%is not a possible row identifier%'
        PRINT N'PASS A3: a negative id is refused, so the guard is <= 0 and not = 0.';
    ELSE
        PRINT CONCAT (N'FAIL A3: wrong message -- ', ERROR_MESSAGE ());
END CATCH;
GO

-- A4. A POSITIVE ID THAT MATCHES NOTHING. No error, and an EMPTY RESULT SET rather than a missing one -- which is why
-- this uses INSERT ... EXEC: the insert succeeds on an empty result set and FAILS on no result set at all, and a row
-- count of zero cannot tell those apart.
BEGIN TRY
    DECLARE @n INT;
    DELETE FROM #Detail;
    INSERT INTO #Detail EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = 2147483647;
    SELECT @n = COUNT (*) FROM #Detail;
    IF @n = 0 PRINT N'PASS A4: a nonexistent id returns an empty result set and no error, not a throw.';
    ELSE      PRINT CONCAT (N'FAIL A4: expected 0 rows for a nonexistent id, got ', @n);
END TRY
BEGIN CATCH
    PRINT CONCAT (N'FAIL A4: a nonexistent id threw instead of returning nothing -- ', ERROR_MESSAGE ());
END CATCH;
GO

-- A5. THE SOFT-DELETED ROW, BY ITS REAL ID. AR7 arriving through dbo.vwHandlerSourceHistory, with 505 never naming
-- IsDeleted. This is also the race 505's header describes: the row was in 504's list when it rendered and is gone now.
BEGIN TRY
    DECLARE @DeletedId INT = (SELECT HandlerSourceId FROM #Ids WHERE Label = N'B1');
    DECLARE @n INT;
    DELETE FROM #Detail;
    INSERT INTO #Detail EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = @DeletedId;
    SELECT @n = COUNT (*) FROM #Detail;
    IF @n = 0 PRINT N'PASS A5: a soft-deleted version returns an empty result set -- the view applies AR7, not the '
                  + N'procedure.';
    ELSE      PRINT CONCAT (N'FAIL A5: a soft-deleted version returned ', @n, N' row(s). Withdrawn data is readable.');
END TRY
BEGIN CATCH
    PRINT CONCAT (N'FAIL A5: reading a soft-deleted version threw -- ', ERROR_MESSAGE ());
END CATCH;
GO


PRINT N'';
PRINT N'--- B. The row, and the PII inversion --------------------------------------------------------------------------';
GO

-- B1. The current version. One row, and CurrentRecord = 1.
BEGIN TRY
    DECLARE @Id INT = (SELECT HandlerSourceId FROM #Ids WHERE Label = N'A2');
    DECLARE @n INT, @Flag BIT;
    DELETE FROM #Detail;
    INSERT INTO #Detail EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = @Id;
    SELECT @n = COUNT (*), @Flag = MIN (CAST (d.CurrentRecord AS TINYINT)) FROM #Detail AS d;
    IF @n = 1 AND @Flag = 1
        PRINT N'PASS B1: the current version returns exactly one row with CurrentRecord = 1.';
    ELSE
        PRINT CONCAT (N'FAIL B1: expected 1 row with CurrentRecord = 1, got ', @n, N' row(s), flag '
                    , COALESCE (CAST (@Flag AS NVARCHAR (3)), N'(null)'));
END TRY
BEGIN CATCH
    PRINT CONCAT (N'FAIL B1: ', ERROR_MESSAGE ());
END CATCH;
GO

-- B2. THE SUPERSEDED VERSION, WHICH IS THE ASSERTION THAT MAKES 504 USEFUL. Had 505 read dbo.vwHandlerSource this
-- would come back empty, and every row in 504's version list except the newest would be a dead link.
BEGIN TRY
    DECLARE @Id INT = (SELECT HandlerSourceId FROM #Ids WHERE Label = N'A1');
    DECLARE @n INT, @Flag BIT;
    DELETE FROM #Detail;
    INSERT INTO #Detail EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = @Id;
    SELECT @n = COUNT (*), @Flag = MIN (CAST (d.CurrentRecord AS TINYINT)) FROM #Detail AS d;
    IF @n = 1 AND @Flag = 0
        PRINT N'PASS B2: a SUPERSEDED version is returned, with CurrentRecord = 0 -- 505 reads the history view.';
    ELSE
        PRINT CONCAT (N'FAIL B2: expected 1 superseded row, got ', @n, N' row(s), flag '
                    , COALESCE (CAST (@Flag AS NVARCHAR (3)), N'(null)')
                    , N'. If 0 rows, 505 has been pointed at dbo.vwHandlerSource and 504''s list is now dead links.');
END TRY
BEGIN CATCH
    PRINT CONCAT (N'FAIL B2: ', ERROR_MESSAGE ());
END CATCH;
GO

-- B3. The other half of B2, measured rather than argued: the SAME id returns nothing through dbo.vwHandlerSource. Two
-- observations of one row, so the difference is a property of the views and not of the fixture.
DECLARE @Id INT = (SELECT HandlerSourceId FROM #Ids WHERE Label = N'A1');
DECLARE @ViaCurrent INT, @ViaHistory INT;
SELECT @ViaCurrent = COUNT (*) FROM dbo.vwHandlerSource        WHERE HandlerSourceId = @Id;
SELECT @ViaHistory = COUNT (*) FROM dbo.vwHandlerSourceHistory WHERE HandlerSourceId = @Id;
IF @ViaCurrent = 0 AND @ViaHistory = 1
    PRINT N'PASS B3: dbo.vwHandlerSource returns 0 rows for that id while dbo.vwHandlerSourceHistory returns 1 -- the '
        + N'view choice in 505 is load-bearing, not incidental.';
ELSE
    PRINT CONCAT (N'FAIL B3: expected 0 through dbo.vwHandlerSource and 1 through the history view, got '
                , @ViaCurrent, N' and ', @ViaHistory);
GO

-- B4. The never-stamped handler. CurrentRecord NULL is RETURNED, not coerced to 0 -- a detail screen showing 0 would
-- say "superseded" about a handler nothing has ever stamped, which sends the reader to the wrong question.
BEGIN TRY
    DECLARE @Id INT = (SELECT HandlerSourceId FROM #Ids WHERE Label = N'C1');
    DECLARE @n INT, @Nulls INT;
    DELETE FROM #Detail;
    INSERT INTO #Detail EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = @Id;
    SELECT @n = COUNT (*)
         , @Nulls = SUM (CASE WHEN d.CurrentRecord IS NULL THEN 1 ELSE 0 END)
      FROM #Detail AS d;
    IF @n = 1 AND @Nulls = 1
        PRINT N'PASS B4: a never-stamped version is returned with CurrentRecord NULL, so the diagnostic survives the '
            + N'projection.';
    ELSE
        PRINT CONCAT (N'FAIL B4: expected 1 row with CurrentRecord NULL, got ', @n, N' row(s), ', @Nulls, N' null(s)');
END TRY
BEGIN CATCH
    PRINT CONCAT (N'FAIL B4: ', ERROR_MESSAGE ());
END CATCH;
GO

-- B5. THE INVERSION, MEASURED. 503's and 504's probes assert that contact columns are ABSENT. This asserts the
-- opposite, with values, because "the detail screen carries them" is a promise the other two headers make on this
-- procedure's behalf. All four sentinels, from the SUPERSEDED row, so it cannot pass by reading A2 instead.
BEGIN TRY
    DECLARE @Id INT = (SELECT HandlerSourceId FROM #Ids WHERE Label = N'A1');
    DECLARE @Hits INT;
    DELETE FROM #Detail;
    INSERT INTO #Detail EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = @Id;
    SELECT @Hits = COUNT (*)
      FROM #Detail AS d
     WHERE d.ContactFirstName = N'ZZPROBEFIRST'
       AND d.ContactLastName  = N'ZZPROBELAST'
       AND d.ContactPhone     = N'5555550199'
       AND d.ContactEmail     = N'zzprobe.contact@example.invalid';
    IF @Hits = 1
        PRINT N'PASS B5: contact first name, last name, phone and email are all returned, with the values filed.';
    ELSE
        PRINT CONCAT (N'FAIL B5: the four contact sentinels did not all come back on the superseded row (', @Hits
                    , N' match). Either the projection dropped them or it read a different version.');
END TRY
BEGIN CATCH
    PRINT CONCAT (N'FAIL B5: ', ERROR_MESSAGE ());
END CATCH;
GO

-- B6. The mailing address, including an OUT-OF-STATE state code. MDE's decision is that out-of-state values are
-- expected on contacts and mailing addresses and never on activityLocation. What this asserts is narrow and worth being
-- precise about: the value survives the read unmolested. dbo.HandlerSource carries ZERO check constraints, measured, so
-- nothing in the schema was ever going to reject it -- the MD-only rule lives in the loader, and this assertion would
-- catch a read that started filtering or rewriting a state code, which is the only way this path could break it.
BEGIN TRY
    DECLARE @Id INT = (SELECT HandlerSourceId FROM #Ids WHERE Label = N'A1');
    DECLARE @Hits INT;
    DELETE FROM #Detail;
    INSERT INTO #Detail EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = @Id;
    SELECT @Hits = COUNT (*)
      FROM #Detail AS d
     WHERE d.SiteMailingAddressAddress1  = N'99 ZZPROBE MAILING WAY'
       AND d.SiteMailingAddressCity      = N'Philadelphia'
       AND d.SiteMailingAddressStateCode = N'PA'
       AND d.SiteMailingAddressZip       = N'19104';
    IF @Hits = 1
        PRINT N'PASS B6: the mailing address is returned whole, and an out-of-state state code passes through '
            + N'unchanged.';
    ELSE
        PRINT CONCAT (N'FAIL B6: the mailing-address sentinels did not come back (', @Hits, N' match).');
END TRY
BEGIN CATCH
    PRINT CONCAT (N'FAIL B6: ', ERROR_MESSAGE ());
END CATCH;
GO

-- B7. SrcUpdatedBy. Excluded from 503 and 504 because it identifies an EPA user; included here because on one record
-- "who at EPA last touched this" is the question being asked. Same reasoning, opposite answer, and this is the
-- assertion that would fail if somebody applied the grid's rule here by reflex.
BEGIN TRY
    DECLARE @Id INT = (SELECT HandlerSourceId FROM #Ids WHERE Label = N'A1');
    DECLARE @Hits INT;
    DELETE FROM #Detail;
    INSERT INTO #Detail EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = @Id;
    SELECT @Hits = COUNT (*) FROM #Detail AS d WHERE d.SrcUpdatedBy = N'ZZPROBE.EPAUSER';
    IF @Hits = 1 PRINT N'PASS B7: SrcUpdatedBy is returned here, unlike in 503 and 504.';
    ELSE         PRINT CONCAT (N'FAIL B7: SrcUpdatedBy did not come back (', @Hits, N' match).');
END TRY
BEGIN CATCH
    PRINT CONCAT (N'FAIL B7: ', ERROR_MESSAGE ());
END CATCH;
GO


PRINT N'';
PRINT N'--- C. The projection, by name ---------------------------------------------------------------------------------';
GO

-- C1. 215 columns, no more and no fewer. Asserted against the DEPLOYED module through
-- sys.dm_exec_describe_first_result_set, which reports what a caller actually receives.
DECLARE @Cols INT;
SELECT @Cols = COUNT (*)
  FROM sys.dm_exec_describe_first_result_set
       (N'EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = 1;', NULL, 0);
IF @Cols = 215 PRINT N'PASS C1: the deployed procedure returns exactly 215 columns.';
ELSE           PRINT CONCAT (N'FAIL C1: expected 215 columns, the deployed procedure returns ', @Cols);
GO

-- C2. The names, in order, against the catalog minus the three documented exclusions. CAST to NVARCHAR (MAX) inside
-- STRING_AGG because 215 names exceed the 8000-byte limit of the NVARCHAR (4000) form, which errors rather than
-- truncating. See the header on why this duplicates build/check_detail_projection.py rather than replacing it.
DECLARE @Projected NVARCHAR (MAX), @Expected NVARCHAR (MAX);
SELECT @Projected = STRING_AGG (CAST (r.name COLLATE DATABASE_DEFAULT AS NVARCHAR (MAX)), N',')
                    WITHIN GROUP (ORDER BY r.column_ordinal)
  FROM sys.dm_exec_describe_first_result_set
       (N'EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = 1;', NULL, 0) AS r;
SELECT @Expected = STRING_AGG (CAST (c.name COLLATE DATABASE_DEFAULT AS NVARCHAR (MAX)), N',')
                   WITHIN GROUP (ORDER BY c.column_id)
  FROM sys.columns AS c
 WHERE c.object_id = OBJECT_ID (N'dbo.vwHandlerSourceHistory')
   AND c.name NOT IN (N'IsDeleted', N'auditDeletedBy', N'auditDeletedDateUtc');
IF @Projected = @Expected
    PRINT N'PASS C2: the projected names are the view''s columns minus the three exclusions, in the view''s own order.';
ELSE
    PRINT CONCAT (N'FAIL C2: projection drift. Projected ', LEN (@Projected), N' chars, expected '
                , LEN (@Expected), N'. Run build/check_detail_projection.py -- it names the columns.');
GO

-- C3. The three exclusions, absent BY NAME, and the five columns that must be PRESENT. The positive half is the point:
-- 503's and 504's probes can only assert that PII is absent, and a projection that returned nothing at all would
-- satisfy that. Here the claim is that these five specific columns arrive, so the inversion is measured in both
-- directions.
DECLARE @BadlyPresent NVARCHAR (MAX), @Missing NVARCHAR (MAX);
;WITH R AS (SELECT r.name COLLATE DATABASE_DEFAULT AS name
              FROM sys.dm_exec_describe_first_result_set
                   (N'EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = 1;', NULL, 0) AS r)
SELECT @BadlyPresent = STRING_AGG (R.name, N', ')
  FROM R
 WHERE R.name IN (N'IsDeleted', N'auditDeletedBy', N'auditDeletedDateUtc');
;WITH Wanted AS (SELECT * FROM (VALUES (N'ContactFirstName'), (N'ContactEmail')
                                     , (N'SiteMailingAddressAddress1'), (N'SrcUpdatedBy')
                                     , (N'CurrentRecord')) AS W (name))
SELECT @Missing = STRING_AGG (Wanted.name, N', ')
  FROM Wanted
 WHERE NOT EXISTS (SELECT 1
                     FROM sys.dm_exec_describe_first_result_set
                          (N'EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = 1;', NULL, 0) AS r
                    WHERE r.name COLLATE DATABASE_DEFAULT = Wanted.name);
IF @BadlyPresent IS NULL AND @Missing IS NULL
    PRINT N'PASS C3: the three provably-constant columns are absent, and ContactFirstName, ContactEmail, '
        + N'SiteMailingAddressAddress1, SrcUpdatedBy and CurrentRecord are all present.';
ELSE
    PRINT CONCAT (N'FAIL C3: wrongly present -- ', COALESCE (@BadlyPresent, N'(none)')
                , N'; wrongly absent -- ', COALESCE (@Missing, N'(none)'));
GO


PRINT N'';
PRINT N'--- L. What the failures recorded, and what they did NOT record ------------------------------------------------';
GO

-- L1. Exactly three error rows above the baseline: A1, A2 and A3. Exact rather than "at least", because an extra row
-- would mean something logged that this file did not expect -- A4, A5 and every assertion in B and C are successes and
-- must write nothing at all.
DECLARE @Rows INT;
SELECT @Rows = COUNT (*)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > (SELECT Value FROM #Base WHERE Label = N'MaxLogId')
   AND l.ProcedureName = N'[dbo].[uspGetHandlerSourceDetail]';
IF @Rows = 3 PRINT N'PASS L1: exactly 3 log rows above the baseline -- the three refusals, and nothing else.';
ELSE         PRINT CONCAT (N'FAIL L1: expected 3 log rows above the baseline, found ', @Rows);
GO

-- L2. The orphan signature on every one of them: Successful = 0, EndDateUtc set, ElapsedMilliseconds NULL. That NULL is
-- what identifies a row written by a CATCH with no start row, and it must stay NULL.
DECLARE @Rows INT, @Orphans INT;
SELECT @Rows = COUNT (*)
     , @Orphans = SUM (CASE WHEN l.Successful = 0 AND l.EndDateUtc IS NOT NULL
                             AND l.ElapsedMilliseconds IS NULL THEN 1 ELSE 0 END)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > (SELECT Value FROM #Base WHERE Label = N'MaxLogId')
   AND l.ProcedureName = N'[dbo].[uspGetHandlerSourceDetail]';
IF @Rows > 0 AND @Rows = @Orphans
    PRINT CONCAT (N'PASS L2: all ', @Rows, N' row(s) carry the orphan signature -- no start row, no elapsed column.');
ELSE
    PRINT CONCAT (N'FAIL L2: ', @Orphans, N' of ', @Rows, N' row(s) carry the orphan signature.');
GO

-- L3. The duration, recovered into ContextMessage. It goes there precisely BECAUSE ElapsedMilliseconds has to stay
-- NULL, so a failure still says how long it took without spoiling the signature L2 depends on.
DECLARE @Rows INT, @WithElapsed INT;
SELECT @Rows = COUNT (*)
     , @WithElapsed = SUM (CASE WHEN l.ContextMessage LIKE N'%ElapsedMs=%' THEN 1 ELSE 0 END)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > (SELECT Value FROM #Base WHERE Label = N'MaxLogId')
   AND l.ProcedureName = N'[dbo].[uspGetHandlerSourceDetail]';
IF @Rows > 0 AND @Rows = @WithElapsed
    PRINT CONCAT (N'PASS L3: all ', @Rows, N' row(s) carry ElapsedMs= in ContextMessage.');
ELSE
    PRINT CONCAT (N'FAIL L3: ', @WithElapsed, N' of ', @Rows, N' row(s) carry ElapsedMs=.');
GO

-- L4. WHAT the refusals recorded. @KeyParameters is one clause and nothing else, so these are equalities rather than
-- LIKEs -- an equality also fails if anything is ever APPENDED to it, which is the direction that matters on a procedure
-- whose result set is full of PII. Both refusals are checked in one assertion because the pair is the point: a NULL
-- rendered as an empty string and a 0 look identical in a log, and then the two refusals become indistinguishable.
DECLARE @Zero INT, @Null INT;
SELECT @Zero = SUM (CASE WHEN l.KeyParameters = N'HandlerSourceId=0'      THEN 1 ELSE 0 END)
     , @Null = SUM (CASE WHEN l.KeyParameters = N'HandlerSourceId=(null)' THEN 1 ELSE 0 END)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > (SELECT Value FROM #Base WHERE Label = N'MaxLogId')
   AND l.ProcedureName = N'[dbo].[uspGetHandlerSourceDetail]';
IF @Zero = 1 AND @Null = 1
    PRINT N'PASS L4: the refused calls logged exactly `HandlerSourceId=0` and `HandlerSourceId=(null)` -- the value '
        + N'the caller sent, with NULL rendered as NULL rather than as an empty string.';
ELSE
    PRINT CONCAT (N'FAIL L4: expected one of each, found ', COALESCE (CAST (@Zero AS NVARCHAR (11)), N'(null)')
                , N' zero-row(s) and ', COALESCE (CAST (@Null AS NVARCHAR (11)), N'(null)'), N' null-row(s).');
GO

-- L5. NO PII IN THE LOG, AND THIS IS THE ASSERTION THE WHOLE PROCEDURE RESTS ON. 505 returns contact names, phone
-- numbers and email addresses to a web page; logs.ExecutionLog is a table that same web app can read. The fixture's
-- sentinels appear nowhere else in this database, so if any of them turns up in any free-text log column then a result
-- set has leaked into a log -- most likely through an error message trying to be helpful about which record failed.
-- Every free-text column is scanned, not just KeyParameters, because @ContextMessage and @ErrorMessage are the two that
-- get extended when somebody is debugging.
DECLARE @Leaks INT;
SELECT @Leaks = COUNT (*)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > (SELECT Value FROM #Base WHERE Label = N'MaxLogId')
   AND (   l.KeyParameters  LIKE N'%ZZPROBE%' OR l.KeyParameters  LIKE N'%5555550199%'
        OR l.ContextMessage LIKE N'%ZZPROBE%' OR l.ContextMessage LIKE N'%5555550199%'
        OR l.ErrorMessage   LIKE N'%ZZPROBE%' OR l.ErrorMessage   LIKE N'%5555550199%'
        OR l.DynamicSql     LIKE N'%ZZPROBE%' OR l.DynamicSql     LIKE N'%5555550199%'
        OR l.Comments       LIKE N'%ZZPROBE%' OR l.Comments       LIKE N'%5555550199%'
        OR l.KeyParameters  LIKE N'%example.invalid%' OR l.ContextMessage LIKE N'%example.invalid%'
        OR l.ErrorMessage   LIKE N'%example.invalid%' OR l.DynamicSql     LIKE N'%example.invalid%'
        OR l.Comments       LIKE N'%example.invalid%');
IF @Leaks = 0
    PRINT N'PASS L5: NO fixture contact name, phone number or email address appears in any free-text column of '
        + N'logs.ExecutionLog. The payload carries PII; the log carries an integer.';
ELSE
    PRINT CONCAT (N'FAIL L5: ', @Leaks, N' log row(s) contain a fixture contact sentinel. A result set has leaked '
                , N'into a table the monitoring web app can read.');
GO

-- L6. No successful-path row, which is the DA1 narrowing holding. A monitoring screen that logged every successful
-- read would make logs.ExecutionLog mostly a record of people looking at things, and would worsen the open G7
-- retention question rather than answering it.
DECLARE @Successes INT;
SELECT @Successes = COUNT (*)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > (SELECT Value FROM #Base WHERE Label = N'MaxLogId')
   AND l.ProcedureName = N'[dbo].[uspGetHandlerSourceDetail]'
   AND l.Successful = 1;
IF @Successes = 0
    PRINT N'PASS L6: no successful-path log row -- this read records failures only.';
ELSE
    PRINT CONCAT (N'FAIL L6: ', @Successes, N' successful-path row(s) written. A detail screen refresh is now a log '
                , N'entry.');
GO


PRINT N'';
PRINT N'--- X. The G37 boundary, measured -----------------------------------------------------------------------------';
GO

-- X1. A CALLER-OWNED DOOMED TRANSACTION. 505 must not roll back a transaction it did not open, and inside a doomed one
-- error 3930 makes it impossible to write the log row BY ANY MEANS until somebody rolls back. So this measures the
-- boundary rather than asserting the requirement is met: XACT_STATE () = -1 and ZERO log rows. Written to print CHANGED
-- rather than PASS if it ever stops being true, because that would be a fixed G37 needing a header update, not a
-- regression. logs.uspRecordExecutionError names 3930 in its severity-10 warning so the one action that fixes it is
-- guessable from the message.
DECLARE @Before BIGINT = (SELECT COALESCE (MAX (l.ExecutionLogId), 0) FROM logs.ExecutionLog AS l);
DECLARE @State INT, @After INT;
BEGIN TRANSACTION;
BEGIN TRY
    EXEC dbo.uspGetHandlerSourceDetail @HandlerSourceId = 0;   -- refused, and the THROW dooms the caller's transaction
END TRY
BEGIN CATCH
    SET @State = XACT_STATE ();
END CATCH;
IF XACT_STATE () <> 0 ROLLBACK TRANSACTION;   -- the CALLER rolls back what the CALLER opened
SELECT @After = COUNT (*)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > @Before
   AND l.ProcedureName = N'[dbo].[uspGetHandlerSourceDetail]';
IF @State = -1 AND @After = 0
    PRINT N'PASS X1: inside a caller-owned doomed transaction XACT_STATE () = -1 and NO log row is written. G37, '
        + N'open by design, and the procedure correctly rolls back nothing.';
ELSE IF @State = -1 AND @After > 0
    PRINT CONCAT (N'CHANGED X1: a doomed transaction now permits ', @After, N' log row(s). G37 may be closable -- '
                , N'update the headers in 500 through 505 before celebrating.');
ELSE
    PRINT CONCAT (N'FAIL X1: expected XACT_STATE () = -1, got ', COALESCE (CAST (@State AS NVARCHAR (3)), N'(null)')
                , N' with ', @After, N' log row(s). If the state is 0 the procedure rolled back a transaction it did '
                , N'not open.');
GO


PRINT N'';
PRINT N'--- I. Nothing credential-shaped anywhere in the log -----------------------------------------------------------';
GO

-- I1. The standing scan. The OR group is parenthesised deliberately -- without the brackets the ExecutionLogId
-- predicate would bind to the last term only and the scan would silently cover one column of one row.
DECLARE @Suspect INT;
SELECT @Suspect = COUNT (*)
  FROM logs.ExecutionLog AS l
 WHERE l.ExecutionLogId > (SELECT Value FROM #Base WHERE Label = N'MaxLogId')
   AND (   l.KeyParameters  LIKE N'%apiKey%'  OR l.KeyParameters  LIKE N'%Bearer %'
        OR l.KeyParameters  LIKE N'%apiId%'   OR l.KeyParameters  LIKE N'%password%'
        OR l.ContextMessage LIKE N'%apiKey%'  OR l.ContextMessage LIKE N'%Bearer %'
        OR l.ContextMessage LIKE N'%apiId%'   OR l.ContextMessage LIKE N'%password%'
        OR l.DynamicSql     LIKE N'%apiKey%'  OR l.DynamicSql     LIKE N'%password%'
        OR l.Comments       LIKE N'%apiKey%'  OR l.Comments       LIKE N'%password%');
IF @Suspect = 0 PRINT N'PASS I1: no credential-shaped text in any log row this run wrote.';
ELSE            PRINT CONCAT (N'FAIL I1: ', @Suspect, N' log row(s) contain credential-shaped text.');
GO

-- Printed so a reader can see for themselves what the log actually holds, rather than trusting the assertions above.
DECLARE @Sample NVARCHAR (MAX), @SampleCtx NVARCHAR (MAX);
SELECT TOP (1) @Sample = l.KeyParameters, @SampleCtx = l.ContextMessage
  FROM logs.ExecutionLog AS l
 WHERE l.ProcedureName = N'[dbo].[uspGetHandlerSourceDetail]'
 ORDER BY l.ExecutionLogId DESC;
PRINT CONCAT (N'sample KeyParameters : ', COALESCE (@Sample, N'(none)'));
PRINT CONCAT (N'sample ContextMessage: ', COALESCE (@SampleCtx, N'(none)'));
GO


-- ---------------------------------------------------------------------------------------------------------------------
-- Cleanup. Soft delete only -- the fixture rows stay and become the leftovers the next run's reset retires.
-- ---------------------------------------------------------------------------------------------------------------------
DROP TABLE IF EXISTS #Detail;
DROP TABLE IF EXISTS #Ids;
DROP TABLE IF EXISTS #Base;

UPDATE dbo.HandlerSource
   SET IsDeleted             = 1
     , auditDeletedBy        = ORIGINAL_LOGIN ()
     , auditDeletedDateUtc   = SYSUTCDATETIME ()
     , auditModifiedBy       = ORIGINAL_LOGIN ()
     , auditModifiedDateUtc  = SYSUTCDATETIME ()
 WHERE HandlerId LIKE N'MDPROBE0505%'
   AND IsDeleted = 0;
PRINT CONCAT (N'cleanup: retired ', @@ROWCOUNT, N' fixture row(s). Soft delete only.');
GO

PRINT N'=== da4_gethandlersourcedetail: done ===';
GO
