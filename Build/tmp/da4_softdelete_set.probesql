-- Probe for dbo.uspSoftDeleteHandlerSourceSet (script 522).
--
-- Every handler used here is a MDPROBE* id that cannot collide with EPA data, and every row this
-- script creates is SOFT-deleted at the end. Nothing is dropped and nothing is removed -- which is
-- also the behaviour under test.
SET NOCOUNT ON;
SET XACT_ABORT ON;

DECLARE @LoadRunId INT, @Rows INT, @Kids INT, @Stamp DATETIME2, @Stamp2 DATETIME2
      , @Msg NVARCHAR (MAX), @Actual NVARCHAR (400), @n INT;

EXEC logs.uspStartLoadRun @RunMode = N'Reconcile', @AllowConcurrent = 1
                        , @MachineName = N'da4_softdelete_set.probesql'
                        , @ApplicationVersion = N'probe'
                        , @LoadRunId = @LoadRunId OUTPUT;
PRINT CONCAT (N'Opened LoadRunId ', @LoadRunId);
PRINT N'';

----------------------------------------------------------------------------------------------------
-- Fixture.
--   MDPROBE00011  two versions; version 2 is the current one and is the one deleted. Version 1 must
--                 survive with its own children, and the handler keeps its other-ids.
--   MDPROBE00012  one version. Deleting it leaves the handler with nothing live, which is the only
--                 case where dbo.HandlerOtherIdentifier goes too.
--   MDPROBE00013  never mentioned in any call. Control.
----------------------------------------------------------------------------------------------------
DECLARE @V11_1 INT, @V11_2 INT, @V12 INT, @V13 INT, @Ep INT, @Hsm INT;

-- Reset first. A previous run that failed part-way through leaves live MDPROBE rows behind, and
-- UX_dbo_HandlerSource_Natural is filtered WHERE IsDeleted = 0, so the fixture insert below would hit
-- a duplicate key and the probe could only ever be run once. Soft-deleting the leftovers frees the
-- key. Only the two handler-keyed tables can collide -- the children hang off new identity values.
UPDATE dbo.HandlerSource SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE HandlerId LIKE N'MDPROBE%' AND IsDeleted = 0;
UPDATE dbo.HandlerOtherIdentifier SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE HandlerId LIKE N'MDPROBE%' AND IsDeleted = 0;

INSERT INTO dbo.HandlerSource (HandlerId, ActivityLocation, SourceType, Sequence, CurrentRecord)
VALUES (N'MDPROBE00011', N'MD', N'N', 1, 0);
SET @V11_1 = SCOPE_IDENTITY ();
INSERT INTO dbo.HandlerSource (HandlerId, ActivityLocation, SourceType, Sequence, CurrentRecord)
VALUES (N'MDPROBE00011', N'MD', N'N', 2, 1);
SET @V11_2 = SCOPE_IDENTITY ();
INSERT INTO dbo.HandlerSource (HandlerId, ActivityLocation, SourceType, Sequence, CurrentRecord)
VALUES (N'MDPROBE00012', N'MD', N'N', 1, 1);
SET @V12 = SCOPE_IDENTITY ();
INSERT INTO dbo.HandlerSource (HandlerId, ActivityLocation, SourceType, Sequence, CurrentRecord)
VALUES (N'MDPROBE00013', N'MD', N'N', 1, 1);
SET @V13 = SCOPE_IDENTITY ();

-- Seven descendant rows under version 11/2, spanning both depths: a child, a child with two
-- grandchildren, a child with one grandchild, and the raw payload.
INSERT INTO dbo.HandlerSourceOwner (HandlerSourceId, OrdinalPosition, Name)
VALUES (@V11_2, 1, N'Probe Owner v2'), (@V11_1, 1, N'Probe Owner v1')
     , (@V12, 1, N'Probe Owner 12'),   (@V13, 1, N'Probe Owner 13');

INSERT INTO dbo.HandlerSourceEpisodicWaste (HandlerSourceId, OrdinalPosition, Description)
VALUES (@V11_2, 1, N'probe episodic waste');
SET @Ep = SCOPE_IDENTITY ();
INSERT INTO dbo.HandlerSourceEpisodicWasteFederalWasteCode
      (HandlerSourceEpisodicWasteId, OrdinalPosition, FederalWasteCode)
VALUES (@Ep, 1, N'D001'), (@Ep, 2, N'D002');

INSERT INTO dbo.HandlerSourceHsmActivity (HandlerSourceId, OrdinalPosition, FacilityCodeCode)
VALUES (@V11_2, 1, N'X');
SET @Hsm = SCOPE_IDENTITY ();
INSERT INTO dbo.HandlerSourceHsmActivityWasteCode
      (HandlerSourceHsmActivityId, OrdinalPosition, WasteCode)
VALUES (@Hsm, 1, N'F001');

INSERT INTO dbo.HandlerSourceRawJson (HandlerSourceId, RawJson)
VALUES (@V11_2, N'{"probe":2}'), (@V11_1, N'{"probe":1}')
     , (@V12, N'{"probe":12}'),  (@V13, N'{"probe":13}');

-- Handler-grained: two for the handler that survives, two for the one that will not, one control.
-- The high-water mark is captured because the reset above soft-deletes rather than removes, so
-- earlier runs leave rows with these same OtherId values behind and a scalar subquery on HandlerId
-- alone would return more than one value.
DECLARE @OidFrom INT = (SELECT ISNULL (MAX (HandlerOtherIdentifierId), 0) FROM dbo.HandlerOtherIdentifier);

INSERT INTO dbo.HandlerOtherIdentifier (HandlerId, ActivityLocation, OtherId)
VALUES (N'MDPROBE00011', N'MD', N'OTHER-11-A'), (N'MDPROBE00011', N'MD', N'OTHER-11-B')
     , (N'MDPROBE00012', N'MD', N'OTHER-12-A'), (N'MDPROBE00012', N'MD', N'OTHER-12-B')
     , (N'MDPROBE00013', N'MD', N'OTHER-13-A');

PRINT N'=== A. Refusals ===';

DECLARE @cases TABLE (Ordinal INT IDENTITY (1,1), Label NVARCHAR (100)
                    , Elements NVARCHAR (MAX), Reason NVARCHAR (200), UseRun BIT);
INSERT INTO @cases (Label, Elements, Reason, UseRun) VALUES
  (N'null LoadRunId',       N'[{"handlerId":"MDPROBE00011","sourceType":"N","sequence":2}]', N'Withdrawn by EPA per reconcile.', 0)
, (N'not JSON',             N'not json', N'Withdrawn by EPA per reconcile.', 1)
, (N'null Reason',          N'[{"handlerId":"MDPROBE00011","sourceType":"N","sequence":2}]', NULL, 1)
, (N'Reason too short',     N'[{"handlerId":"MDPROBE00011","sourceType":"N","sequence":2}]', N'cleanup', 1)
, (N'incomplete key',       N'[{"handlerId":"MDPROBE00011","sourceType":"N"}]', N'Withdrawn by EPA per reconcile.', 1)
, (N'handlerId too wide',   N'[{"handlerId":"MDPROBE000112345","sourceType":"N","sequence":2}]', N'Withdrawn by EPA per reconcile.', 1)
, (N'duplicate version',    N'[{"handlerId":"MDPROBE00011","sourceType":"N","sequence":2}
                              ,{"handlerId":"MDPROBE00011","sourceType":"N","sequence":2}]', N'Withdrawn by EPA per reconcile.', 1);

DECLARE @i INT = 1, @lbl NVARCHAR (100), @el NVARCHAR (MAX), @rsn NVARCHAR (200)
      , @useRun BIT, @runArg INT;
SET @n = (SELECT COUNT (*) FROM @cases);
WHILE @i <= @n
BEGIN
    SELECT @lbl = Label, @el = Elements, @rsn = Reason, @useRun = UseRun
      FROM @cases WHERE Ordinal = @i;
    SET @runArg = CASE WHEN @useRun = 1 THEN @LoadRunId ELSE NULL END;
    BEGIN TRY
        EXEC dbo.uspSoftDeleteHandlerSourceSet @LoadRunId = @runArg, @Elements = @el, @Reason = @rsn;
        PRINT CONCAT (N'  FAIL  ', @lbl, N' was accepted.');
    END TRY
    BEGIN CATCH
        PRINT CONCAT (N'  ok    ', @lbl, N' -> ', LEFT (ERROR_MESSAGE (), 88));
    END CATCH;
    SET @i += 1;
END;

-- A refusal must leave the fixture exactly as it was. This is the assertion that matters most in
-- section A: a validation error that had already deleted something would be undetectable otherwise.
SELECT @n = COUNT (*) FROM dbo.HandlerSource WHERE HandlerId LIKE N'MDPROBE0001%' AND IsDeleted = 0;
PRINT CONCAT (N'  live versions after 7 refusals = ', @n
            , CASE WHEN @n = 4 THEN N'   ok  (nothing was deleted)' ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== B. Delete the CURRENT version of a handler that has history ===';
EXEC dbo.uspSoftDeleteHandlerSourceSet
      @LoadRunId    = @LoadRunId
    , @Elements     = N'[{"handlerId":"MDPROBE00011","sourceType":"N","sequence":2}]'
    , @Reason       = N'Absent from /hd/sources/summaries on two consecutive full reconciles (G23).'
    , @RowsAffected = @Rows OUTPUT
    , @ChildRows    = @Kids OUTPUT;
PRINT CONCAT (N'  versionsDeleted = ', @Rows, N', descendantRows = ', @Kids
            , CASE WHEN @Rows = 1 AND @Kids = 7
                   THEN N'   ok  (1 parent, 7 descendants across both depths)' ELSE N'   FAIL  expected 1 and 7' END);

SELECT @Actual = STRING_AGG (CONCAT (Sequence, N'=', CASE WHEN IsDeleted = 1 THEN N'del' ELSE N'live' END), N' ')
                   WITHIN GROUP (ORDER BY Sequence)
  -- Scoped to this run's two rows. Filtering on HandlerId alone would pull in the soft-deleted
  -- leftovers of every previous run, since the reset deletes rather than removes.
  FROM dbo.HandlerSource WHERE HandlerSourceId IN (@V11_1, @V11_2);
PRINT CONCAT (N'  MDPROBE00011 versions: ', @Actual
            , CASE WHEN @Actual = N'1=live 2=del' THEN N'   ok  (history survives)' ELSE N'   FAIL' END);

-- The cascade, depth by depth. A grandchild left live is the disclosure this procedure exists to
-- prevent, and it is reachable only through its own parent's key -- so it is checked by id.
SELECT @Actual = CONCAT (N'owner=',      (SELECT CAST (IsDeleted AS NVARCHAR (1)) FROM dbo.HandlerSourceOwner WHERE HandlerSourceId = @V11_2)
                       , N' rawjson=',   (SELECT CAST (IsDeleted AS NVARCHAR (1)) FROM dbo.HandlerSourceRawJson WHERE HandlerSourceId = @V11_2)
                       , N' episodic=',  (SELECT CAST (IsDeleted AS NVARCHAR (1)) FROM dbo.HandlerSourceEpisodicWaste WHERE HandlerSourceEpisodicWasteId = @Ep)
                       , N' epcodes=',   (SELECT CAST (MIN (CAST (IsDeleted AS INT)) AS NVARCHAR (1)) FROM dbo.HandlerSourceEpisodicWasteFederalWasteCode WHERE HandlerSourceEpisodicWasteId = @Ep)
                       , N' hsm=',       (SELECT CAST (IsDeleted AS NVARCHAR (1)) FROM dbo.HandlerSourceHsmActivity WHERE HandlerSourceHsmActivityId = @Hsm)
                       , N' hsmcodes=',  (SELECT CAST (MIN (CAST (IsDeleted AS INT)) AS NVARCHAR (1)) FROM dbo.HandlerSourceHsmActivityWasteCode WHERE HandlerSourceHsmActivityId = @Hsm));
PRINT CONCAT (N'  cascade: ', @Actual
            , CASE WHEN @Actual = N'owner=1 rawjson=1 episodic=1 epcodes=1 hsm=1 hsmcodes=1'
                   THEN N'   ok  (children AND grandchildren)' ELSE N'   FAIL' END);

SELECT @n = COUNT (*) FROM dbo.HandlerSourceOwner WHERE HandlerSourceId = @V11_1 AND IsDeleted = 0;
SELECT @n += COUNT (*) FROM dbo.HandlerSourceRawJson WHERE HandlerSourceId = @V11_1 AND IsDeleted = 0;
PRINT CONCAT (N'  version 1''s own descendants still live = ', @n
            , CASE WHEN @n = 2 THEN N'   ok  (the cascade is version-scoped)' ELSE N'   FAIL' END);

SELECT @n = COUNT (*) FROM dbo.HandlerOtherIdentifier
 WHERE HandlerId = N'MDPROBE00011' AND IsDeleted = 0;
PRINT CONCAT (N'  other identifiers still live = ', @n
            , CASE WHEN @n = 2 THEN N'   ok  (handler-grained, handler still has a live version)'
                   ELSE N'   FAIL  deleting one version must not remove the handler''s other-ids' END);

-- CurrentRecord must be left as it stood. Clearing it would destroy the record of which version was
-- current at the moment it was withdrawn, and would conflate deleted with superseded ([R4]).
SELECT @Actual = CONCAT (N'CurrentRecord=', COALESCE (CAST (CurrentRecord AS NVARCHAR (1)), N'NULL'))
  FROM dbo.HandlerSource WHERE HandlerSourceId = @V11_2;
PRINT CONCAT (N'  deleted version still reads ', @Actual
            , CASE WHEN @Actual = N'CurrentRecord=1'
                   THEN N'   ok  (deleted is not superseded)' ELSE N'   FAIL' END);

SELECT @Actual = CONCAT (Severity, N'/', ObservationType, N' [', ObservedValue, N']')
  FROM logs.DataQualityObservation
 WHERE LoadRunId = @LoadRunId AND HandlerId = N'MDPROBE00011' AND IsDeleted = 0;
PRINT CONCAT (N'  observation: ', COALESCE (@Actual, N'(none)')
            , CASE WHEN @Actual = N'Warning/CurrentRecordMissingInMirror [1 live versions remain, none current]'
                   THEN N'   ok  (the handler is now absent from dbo.vwHandlerSource)' ELSE N'   FAIL' END);

SELECT @n = COUNT (*) FROM dbo.vwHandlerSource WHERE HandlerId = N'MDPROBE00011';
PRINT CONCAT (N'  rows in dbo.vwHandlerSource for MDPROBE00011 = ', @n
            , CASE WHEN @n = 0 THEN N'   ok  (which is exactly what the Warning reports)' ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== C. A second identical delete writes nothing and moves no audit stamp ===';
SELECT @Stamp = MAX (auditDeletedDateUtc) FROM dbo.HandlerSource WHERE HandlerSourceId = @V11_2;
WAITFOR DELAY '00:00:00.050';
EXEC dbo.uspSoftDeleteHandlerSourceSet
      @LoadRunId    = @LoadRunId
    , @Elements     = N'[{"handlerId":"MDPROBE00011","sourceType":"N","sequence":2}]'
    , @Reason       = N'Absent from /hd/sources/summaries on two consecutive full reconciles (G23).'
    , @RowsAffected = @Rows OUTPUT
    , @ChildRows    = @Kids OUTPUT;
SELECT @Stamp2 = MAX (auditDeletedDateUtc) FROM dbo.HandlerSource WHERE HandlerSourceId = @V11_2;
PRINT CONCAT (N'  versionsDeleted = ', @Rows, N', descendantRows = ', @Kids
            , N', auditDeletedDateUtc moved = ', CASE WHEN @Stamp2 > @Stamp THEN N'YES' ELSE N'no' END
            , CASE WHEN @Rows = 0 AND @Kids = 0 AND @Stamp2 = @Stamp
                   THEN N'   ok  (converged; the row still says when it was really deleted)'
                   ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== D. Delete a handler''s ONLY version: the other identifiers go too ===';
EXEC dbo.uspSoftDeleteHandlerSourceSet
      @LoadRunId    = @LoadRunId
    , @Elements     = N'[{"handlerId":"MDPROBE00012","sourceType":"N","sequence":1}]'
    , @Reason       = N'Handler withdrawn from RCRAInfo entirely; confirmed by re-fetch (404).'
    , @RowsAffected = @Rows OUTPUT
    , @ChildRows    = @Kids OUTPUT;
SELECT @n = COUNT (*) FROM dbo.HandlerOtherIdentifier
 WHERE HandlerId = N'MDPROBE00012' AND IsDeleted = 0;
PRINT CONCAT (N'  versionsDeleted = ', @Rows, N', descendantRows = ', @Kids
            , N', other identifiers still live = ', @n
            , CASE WHEN @Rows = 1 AND @Kids = 4 AND @n = 0
                   THEN N'   ok  (2 descendants + 2 other-ids; the handler is gone)'
                   ELSE N'   FAIL  expected 1, 4, 0' END);

-- No live version remains, so there is no handler left to be missing from the view: the Warning is
-- about a handler stranded WITHOUT a current version, not about one that has left entirely.
SELECT @n = COUNT (*) FROM logs.DataQualityObservation
 WHERE LoadRunId = @LoadRunId AND HandlerId = N'MDPROBE00012' AND IsDeleted = 0;
PRINT CONCAT (N'  observations for MDPROBE00012 = ', @n
            , CASE WHEN @n = 0 THEN N'   ok  (nothing live is stranded)' ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== E. The audit trail is NOT cascaded ===';
-- A HandlerLoadStatus row pointing at the version deleted in B. Withdrawing the version does not make
-- it false that the loader fetched it, and check_cascade_coverage.py enforces the same exclusion from
-- the other side.
INSERT INTO logs.HandlerLoadStatus
      (LoadRunId, HandlerId, ActivityLocation, SourceType, Sequence, HandlerSourceId, Status)
VALUES (@LoadRunId, N'MDPROBE00011', N'MD', N'N', 2, @V11_2, N'Succeeded');
EXEC dbo.uspSoftDeleteHandlerSourceSet
      @LoadRunId    = @LoadRunId
    , @Elements     = N'[{"handlerId":"MDPROBE00011","sourceType":"N","sequence":1}]'
    , @Reason       = N'Second version withdrawn; retiring the remaining history for this probe.'
    , @RowsAffected = @Rows OUTPUT, @ChildRows = @Kids OUTPUT;
SELECT @n = COUNT (*) FROM logs.HandlerLoadStatus
 WHERE LoadRunId = @LoadRunId AND HandlerId = N'MDPROBE00011' AND IsDeleted = 0;
PRINT CONCAT (N'  MDPROBE00011 now has no live version; live HandlerLoadStatus rows = ', @n
            , CASE WHEN @n = 1 THEN N'   ok  (the mirror is cascaded, the audit trail is not)'
                   ELSE N'   FAIL  the record of what the loader did was deleted with the data' END);
SELECT @n = COUNT (*) FROM logs.HandlerLoadStatus AS s
  JOIN dbo.HandlerSource AS h ON h.HandlerSourceId = s.HandlerSourceId
 WHERE s.LoadRunId = @LoadRunId AND s.HandlerId = N'MDPROBE00011';
PRINT CONCAT (N'  and it still joins its (deleted) parent: rows = ', @n
            , CASE WHEN @n = 1 THEN N'   ok  (soft delete does not break referential integrity)'
                   ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== F. The control handler was not touched anywhere ===';
SELECT @Actual = CONCAT (N'version=', (SELECT CAST (IsDeleted AS NVARCHAR (1)) FROM dbo.HandlerSource WHERE HandlerSourceId = @V13)
                       , N' owner=',  (SELECT CAST (IsDeleted AS NVARCHAR (1)) FROM dbo.HandlerSourceOwner WHERE HandlerSourceId = @V13)
                       , N' rawjson=',(SELECT CAST (IsDeleted AS NVARCHAR (1)) FROM dbo.HandlerSourceRawJson WHERE HandlerSourceId = @V13)
                       , N' otherid=',(SELECT CAST (IsDeleted AS NVARCHAR (1)) FROM dbo.HandlerOtherIdentifier WHERE HandlerId = N'MDPROBE00013' AND HandlerOtherIdentifierId > @OidFrom));
PRINT CONCAT (N'  MDPROBE00013: ', @Actual
            , CASE WHEN @Actual = N'version=0 owner=0 rawjson=0 otherid=0'
                   THEN N'   ok  (out of scope, left alone)' ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== G. A version that is already deleted is notFound, not an error ===';
EXEC dbo.uspSoftDeleteHandlerSourceSet
      @LoadRunId    = @LoadRunId
    , @Elements     = N'[{"handlerId":"MDPROBE00012","sourceType":"N","sequence":1}
                        ,{"handlerId":"MDPROBE00099","sourceType":"N","sequence":7}]'
    , @Reason       = N'Re-run of a withdrawal set after an interrupted reconcile.'
    , @RowsAffected = @Rows OUTPUT, @ChildRows = @Kids OUTPUT;
PRINT CONCAT (N'  versionsDeleted = ', @Rows, N', descendantRows = ', @Kids
            , CASE WHEN @Rows = 0 AND @Kids = 0 THEN N'   ok' ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== H. Empty array is a no-op, not an error ===';
EXEC dbo.uspSoftDeleteHandlerSourceSet
      @LoadRunId = @LoadRunId, @Elements = N'[]'
    , @Reason = N'Reconcile found nothing to withdraw on this pass.'
    , @RowsAffected = @Rows OUTPUT, @ChildRows = @Kids OUTPUT;
PRINT CONCAT (N'  versionsDeleted = ', @Rows, N', descendantRows = ', @Kids
            , CASE WHEN @Rows = 0 AND @Kids = 0 THEN N'   ok' ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== I. Comments on the successful executions, newest last ===';
DECLARE @log TABLE (Ordinal INT IDENTITY (1,1), Comments NVARCHAR (MAX));
INSERT INTO @log (Comments)
SELECT Comments FROM logs.ExecutionLog
 WHERE ProcedureName = N'[dbo].[uspSoftDeleteHandlerSourceSet]' AND Successful = 1
 ORDER BY ExecutionLogId;
SELECT @i = 1, @n = (SELECT COUNT (*) FROM @log);
WHILE @i <= @n
BEGIN
    SELECT @Msg = Comments FROM @log WHERE Ordinal = @i;
    PRINT CONCAT (N'  ', LEFT (@Msg, 200));
    SET @i += 1;
END;
PRINT N'  (each must carry the reason -- it is recorded here and nowhere else)';

PRINT N'';
PRINT N'=== J. A closed run refuses further work ===';
EXEC logs.uspCompleteLoadRun @LoadRunId = @LoadRunId, @Status = N'Succeeded';
BEGIN TRY
    EXEC dbo.uspSoftDeleteHandlerSourceSet
          @LoadRunId = @LoadRunId
        , @Elements = N'[{"handlerId":"MDPROBE00013","sourceType":"N","sequence":1}]'
        , @Reason = N'Should never be applied: the run is closed.';
    PRINT N'  FAIL: a closed run accepted a delete.';
END TRY
BEGIN CATCH
    PRINT CONCAT (N'  ok    -> ', LEFT (ERROR_MESSAGE (), 104));
END CATCH;
SELECT @n = COUNT (*) FROM dbo.HandlerSource WHERE HandlerSourceId = @V13 AND IsDeleted = 0;
PRINT CONCAT (N'  MDPROBE00013 still live = ', @n
            , CASE WHEN @n = 1 THEN N'   ok' ELSE N'   FAIL' END);

PRINT N'';
PRINT N'=== Cleanup: soft delete only ===';
UPDATE dbo.HandlerSourceEpisodicWasteFederalWasteCode SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE HandlerSourceEpisodicWasteId IN (SELECT HandlerSourceEpisodicWasteId FROM dbo.HandlerSourceEpisodicWaste
                                         WHERE HandlerSourceId IN (SELECT HandlerSourceId FROM dbo.HandlerSource WHERE HandlerId LIKE N'MDPROBE%'));
UPDATE dbo.HandlerSourceHsmActivityWasteCode SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE HandlerSourceHsmActivityId IN (SELECT HandlerSourceHsmActivityId FROM dbo.HandlerSourceHsmActivity
                                        WHERE HandlerSourceId IN (SELECT HandlerSourceId FROM dbo.HandlerSource WHERE HandlerId LIKE N'MDPROBE%'));
UPDATE c SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
  FROM dbo.HandlerSourceEpisodicWaste AS c JOIN dbo.HandlerSource AS h ON h.HandlerSourceId = c.HandlerSourceId
 WHERE h.HandlerId LIKE N'MDPROBE%';
UPDATE c SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
  FROM dbo.HandlerSourceHsmActivity AS c JOIN dbo.HandlerSource AS h ON h.HandlerSourceId = c.HandlerSourceId
 WHERE h.HandlerId LIKE N'MDPROBE%';
UPDATE c SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
  FROM dbo.HandlerSourceOwner AS c JOIN dbo.HandlerSource AS h ON h.HandlerSourceId = c.HandlerSourceId
 WHERE h.HandlerId LIKE N'MDPROBE%';
UPDATE c SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
  FROM dbo.HandlerSourceRawJson AS c JOIN dbo.HandlerSource AS h ON h.HandlerSourceId = c.HandlerSourceId
 WHERE h.HandlerId LIKE N'MDPROBE%';
UPDATE dbo.HandlerOtherIdentifier SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE HandlerId LIKE N'MDPROBE%';
UPDATE dbo.HandlerSource SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE HandlerId LIKE N'MDPROBE%';
UPDATE logs.HandlerLoadStatus SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE LoadRunId = @LoadRunId;
UPDATE logs.DataQualityObservation SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE LoadRunId = @LoadRunId;
UPDATE logs.LoadRun SET IsDeleted = 1, auditDeletedDateUtc = SYSUTCDATETIME ()
 WHERE LoadRunId = @LoadRunId;
PRINT N'  done.';
